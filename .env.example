VITE_SUPABASE_PROJECT_ID="your-supabase-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://your-supabase-project-ref.supabase.co"
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key"

# Canonical public URL used in auth emails (password reset, signup confirmation).
# Set per deployment — e.g. https://app.salci.ai for the school portal
# (www.salci.org serves the same build; Android app builds must use
# https://www.salci.org, see docs/mobile/README.md),
# https://www.salci.sale for the .sale frontend. When unset, falls back to
# window.location.origin (correct for normal hosting; only wrong if a prod
# build is somehow served from a localhost origin).
VITE_PUBLIC_URL="https://www.salci.org"
